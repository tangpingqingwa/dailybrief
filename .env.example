# Copy to .env on the VPS. Never commit real secrets.

# Process binds 0.0.0.0:$PORT (default 3000).
PORT=3000

NODE_ENV=production

# Required when NODE_ENV=production. Persist this path on a volume.
DAILYBRIEF_DATABASE=/app/data/dailybrief.sqlite

# Required in production (min 16 chars). Dev uses a fixed local secret.
AUTH_SECRET=replace-with-at-least-16-chars

# Public origin used in magic-link and unsubscribe URLs.
PUBLIC_BASE_URL=https://dailybrief.example

# Kill switch after the 90-day review. 0/1 only.
FREEZE_NEW_SOURCES=0

# ClipAPI. Leave unset in CI. Image does not bake a key.
# CLIPAPI_BASE=https://api.clipapi.dev
# CLIPAPI_KEY=

# Live mail is off by default. Only EMAIL_LIVE=1 plus provider + secrets goes live.
# EMAIL_FIXTURE_ONLY=1 always wins (CI / test.sh).
EMAIL_LIVE=0
# EMAIL_PROVIDER=resend
# EMAIL_FROM=DailyBrief <brief@dailybrief.example>
# RESEND_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Live Stripe is off by default. Only STRIPE_LIVE=1 plus secrets goes live.
STRIPE_LIVE=0
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=

# Live Slack incoming webhooks on the daily send path. Off by default.
# User webhook URLs are stored per Pro account; this flag only enables the HTTP client.
SLACK_LIVE=0
